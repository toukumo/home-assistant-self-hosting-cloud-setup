{
    "preview_features": {
        "stt_v2": {
            "description": "\u0422\u0435\u0441\u0442\u0438\u0440\u0430\u043c\u043e \u043d\u043e\u0432\u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0437\u0430 \u043f\u0440\u0435\u0442\u0432\u0430\u0440\u0430\u045a\u0435 \u0433\u043e\u0432\u043e\u0440\u0430 \u0443 \u0442\u0435\u043a\u0441\u0442 \u0437\u0430 \u201eHome Assistant Cloud\u201d \u2013 \u0434\u0435\u043e \u0433\u043b\u0430\u0441\u043e\u0432\u043d\u043e\u0433 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u045a\u0430 \u043a\u043e\u0458\u0438 \u043e\u043d\u043e \u0448\u0442\u043e \u0438\u0437\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0435 \u043f\u0440\u0435\u0442\u0432\u0430\u0440\u0430 \u0443 \u0440\u0435\u0447\u0438. \u0423 \u043d\u0430\u0448\u0435\u043c \u0442\u0435\u0441\u0442\u0438\u0440\u0430\u045a\u0443, \u043e\u0432\u0430\u0458 \u0441\u0438\u0441\u0442\u0435\u043c \u0441\u0435 \u0431\u043e\u0459\u0435 \u0441\u043d\u0430\u043b\u0430\u0437\u0438 \u0441\u0430 \u0430\u043a\u0446\u0435\u043d\u0442\u0438\u043c\u0430, \u043f\u043e\u0437\u0430\u0434\u0438\u043d\u0441\u043a\u043e\u043c \u0431\u0443\u043a\u043e\u043c \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u0458\u0435\u0437\u0438\u0446\u0438\u043c\u0430 \u043e\u0441\u0438\u043c \u0435\u043d\u0433\u043b\u0435\u0441\u043a\u043e\u0433.\n\n\u0414\u043e\u043a \u0458\u0435 \u043e\u0432\u0430 \u043e\u043f\u0446\u0438\u0458\u0430 \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u0430\u043d\u0430, \u0441\u0430\u0432 \u0430\u0443\u0434\u0438\u043e \u0441\u0430\u0434\u0440\u0436\u0430\u0458 \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u0433\u043b\u0430\u0441\u043e\u0432\u043d\u0438\u0445 \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u043e\u0431\u0440\u0430\u0452\u0443\u0458\u0435 [\u201eSoniox\u201d](https://soniox.com/) \u0443\u043c\u0435\u0441\u0442\u043e \u043d\u0430\u0448\u0435\u0433 \u0442\u0440\u0435\u043d\u0443\u0442\u043d\u043e\u0433 \u043f\u0440\u043e\u0432\u0430\u0458\u0434\u0435\u0440\u0430. \u041e\u0432\u043e \u0458\u0435 \u0432\u0430\u0436\u043d\u043e \u0441\u0430\u043c\u043e \u0437\u0430 \u0430\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0435 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0438\u0441\u0430\u043d\u0438 \u0434\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u201eHome Assistant Cloud\u201d \u043a\u0430\u043e \u201eSTT\u201d \u0441\u0438\u0441\u0442\u0435\u043c. \u0410\u0443\u0434\u0438\u043e \u043f\u0440\u043e\u043b\u0430\u0437\u0438 \u043a\u0440\u043e\u0437 \u201eNabu Casa\u201d \u043f\u0440\u043e\u043a\u0441\u0438, \u043a\u043e\u0458\u0438 \u0443\u043f\u0440\u0430\u0432\u0459\u0430 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u043e\u043c \u0438 \u043f\u0440\u043e\u0441\u043b\u0435\u0452\u0443\u0458\u0435 \u0433\u0430 \u0443 \u0432\u0430\u043c\u0430 \u043d\u0430\u0458\u0431\u043b\u0438\u0436\u0438 \u0440\u0435\u0433\u0438\u043e\u043d \u0437\u0430 \u043e\u0431\u0440\u0430\u0434\u0443. \u201eNabu Casa\u201d \u043d\u0438 \u0443 \u0458\u0435\u0434\u043d\u043e\u043c \u0442\u0440\u0435\u043d\u0443\u0442\u043a\u0443 \u043d\u0435 \u043e\u0431\u0440\u0430\u0452\u0443\u0458\u0435, \u043d\u0435 \u0441\u043a\u043b\u0430\u0434\u0438\u0448\u0442\u0438 \u043d\u0438\u0442\u0438 \u0431\u0435\u043b\u0435\u0436\u0438 \u0432\u0430\u0448 \u0430\u0443\u0434\u0438\u043e \u0441\u0430\u0434\u0440\u0436\u0430\u0458. \u0421\u0432\u0435 \u043e\u0441\u0442\u0430\u043b\u043e \u0443 \u0432\u0430\u0448\u0435\u043c \u0433\u043b\u0430\u0441\u043e\u0432\u043d\u043e\u043c \u0442\u043e\u043a\u0443 \u043e\u0441\u0442\u0430\u0458\u0435 \u0438\u0441\u0442\u043e, \u0430 \u043e\u0432\u0443 \u043e\u043f\u0446\u0438\u0458\u0443 \u043c\u043e\u0436\u0435\u0442\u0435 \u0438\u0441\u043a\u0459\u0443\u0447\u0438\u0442\u0438 \u0443 \u0431\u0438\u043b\u043e \u043a\u043e\u043c \u0442\u0440\u0435\u043d\u0443\u0442\u043a\u0443.",
            "name": "\u041d\u043e\u0432\u0438 \u0441\u0438\u0441\u0442\u0435\u043c \u0437\u0430 \u043f\u0440\u0435\u0442\u0432\u0430\u0440\u0430\u045a\u0435 \u0433\u043e\u0432\u043e\u0440\u0430 \u0443 \u0442\u0435\u043a\u0441\u0442"
