    "preview_features": {
        "stt_v2": {
            "description": "Home Assistant Cloud\uc758 \uc0c8\ub85c\uc6b4 \uc74c\uc131 \uc778\uc2dd \uc5d4\uc9c4\uc744 \ud14c\uc2a4\ud2b8\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc5d4\uc9c4\uc740 \uc74c\uc131 \uc81c\uc5b4\uc5d0\uc11c \uc0ac\uc6a9\uc790\uac00 \ub9d0\ud55c \ub0b4\uc6a9\uc744 \ud14d\uc2a4\ud2b8\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. \ud14c\uc2a4\ud2b8 \uacb0\uacfc, \uc5b5\uc591\uacfc \ubc30\uacbd \uc18c\uc74c \ubc0f \uc601\uc5b4 \uc774\uc678\uc758 \uc5b8\uc5b4\ub97c \ub354 \uc798 \ucc98\ub9ac\ud569\ub2c8\ub2e4.\n\n\uc774 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\ub294 \ub3d9\uc548\uc5d0\ub294 \uc74c\uc131 \uba85\ub839\uc758 \uc624\ub514\uc624\uac00 \ud604\uc7ac \uc81c\uacf5\uc5c5\uccb4 \ub300\uc2e0 [Soniox](https://soniox.com/)\uc5d0\uc11c \ucc98\ub9ac\ub429\ub2c8\ub2e4. \uc774\ub294 STT \uc5d4\uc9c4\uc73c\ub85c Home Assistant Cloud\ub97c \uc0ac\uc6a9\ud558\ub3c4\ub85d \uad6c\uc131\ub41c \uc5b4\uc2dc\uc2a4\ud134\ud2b8\uc5d0\ub9cc \ud574\ub2f9\ud569\ub2c8\ub2e4. \uc624\ub514\uc624\ub294 \uc778\uc99d\uc744 \ucc98\ub9ac\ud558\uace0 \uc0ac\uc6a9\uc790\uc640 \uac00\uc7a5 \uac00\uae4c\uc6b4 \ucc98\ub9ac \uc9c0\uc5ed\uc73c\ub85c \uc804\ub2ec\ud558\ub294 Nabu Casa \ud504\ub85d\uc2dc\ub97c \uac70\uce69\ub2c8\ub2e4. Nabu Casa\ub294 \uc5b4\ub5a4 \uc2dc\uc810\uc5d0\ub3c4 \uc624\ub514\uc624\ub97c \ucc98\ub9ac\ud558\uac70\ub098 \uc800\uc7a5 \ub610\ub294 \uae30\ub85d\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc74c\uc131 \ud30c\uc774\ud504\ub77c\uc778\uc758 \ub098\uba38\uc9c0 \ubd80\ubd84\uc740 \uadf8\ub300\ub85c \uc720\uc9c0\ub418\uba70 \uc5b8\uc81c\ub4e0\uc9c0 \uc774 \uae30\ub2a5\uc744 \ub2e4\uc2dc \ub04c \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
            "disable_confirmation": "\ud604\uc7ac \uc0c8 \uc5d4\uc9c4\uc744 \uc0ac\uc6a9\ud558\ub294 \ubaa8\ub4e0 \uc5b4\uc2dc\uc2a4\ud134\ud2b8\uac00 \uae30\uc874 \uc74c\uc131 \uc778\uc2dd \uc81c\uacf5\uc5c5\uccb4\ub97c \ub2e4\uc2dc \uc0ac\uc6a9\ud569\ub2c8\ub2e4.",
            "enable_confirmation": "\uc774 \uae30\ub2a5\uc740 \uc544\uc9c1 \uac1c\ubc1c \uc911\uc774\uba70 \ubcc0\uacbd\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\ub294 \ub3d9\uc548\uc5d0\ub294 \uc9c0\uc6d0\ub418\ub294 \uc5b8\uc5b4\ub85c \ub41c \uc74c\uc131 \uba85\ub839\uc758 \uc624\ub514\uc624\uac00 \ud604\uc7ac \uc81c\uacf5\uc5c5\uccb4 \ub300\uc2e0 Soniox\uc5d0\uc11c \ud14d\uc2a4\ud2b8\ub85c \ubcc0\ud658\ub429\ub2c8\ub2e4.",
            "name": "\uc0c8\ub85c\uc6b4 \uc74c\uc131 \uc778\uc2dd \uc5d4\uc9c4"
        }
    },
